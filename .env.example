# Configuración LOCAL de EstateHub Cloud. Copia este archivo a .env (está en .gitignore).
# Nunca subas .env al repositorio ni uses estos valores en la nube.

# Obligatorio. La app no arranca sin un secreto de al menos 32 caracteres.
# Este valor de ejemplo es público y la app lo rechaza a propósito: genera uno propio con
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=reemplaza-con-un-secreto-generado

# Emisor y audiencia del token. En Cloud Run, deploy.yml fija JWT_AUDIENCE con el nombre del servicio.
JWT_ISSUER=estatehub-cloud
JWT_AUDIENCE=estatehub-local
JWT_EXPIRE_MINUTES=60

# OWNER y COMMIT_SHA no se configuran en local: en Cloud Run los fija deploy.yml (dueño/repositorio
# y el SHA del commit desplegado) y /health los devuelve como "owner" y "commit".

# Orígenes CORS permitidos en local (lista JSON). En producción solo el dominio del frontend.
CORS_ORIGINS=["http://localhost:3000"]

# Datos de demostración solo en local. Las contraseñas de ejemplo son públicas por estar aquí:
# cámbialas si quieres y no las reutilices en ningún otro sistema.
# Cuentas que se crean:
#   ana@altamira.gt     (agente, dueña de los inmuebles 1 y 2)  -> DEMO_AGENT_PASSWORD
#   carlos@veranda.gt   (agente, dueño del inmueble 3)          -> DEMO_AGENT_PASSWORD
#   admin@estatehub.gt  (Sofía, rol admin)                      -> DEMO_ADMIN_PASSWORD
SEED_DEMO_DATA=true
DEMO_AGENT_PASSWORD=demo-agente-local-2027
DEMO_ADMIN_PASSWORD=demo-admin-local-2027

# Extensión opcional: pitch con Gemini. Vacío = pitch determinista sin llamadas de red.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Alternativa sin llave: Vertex AI con credenciales de aplicación (gcloud auth application-default login)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
